# Frontend (Next.js) environment variables.
# Copy to .env for local dev; set these in the Vercel dashboard for production.

# NextAuth session secret. Generate a new one with: openssl rand -base64 32
NEXTAUTH_SECRET=replace-me

# Canonical URL of the deployed frontend (no trailing slash).
# Local: http://localhost:3000   Production: https://<your-project>.vercel.app
NEXTAUTH_URL=http://localhost:3000

# Base URL of the Flask backend. NOTE: NEXT_PUBLIC_* is baked in at BUILD time,
# so set this in Vercel before building.
# Local: http://127.0.0.1:8080    Production: https://<your-backend>.onrender.com
NEXT_PUBLIC_LOCAL_URL=http://127.0.0.1:8080

# MongoDB Atlas connection string used by NextAuth/Mongoose for the user store.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/db
