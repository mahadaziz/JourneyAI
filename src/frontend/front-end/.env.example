# Copy to .env for local development. Set production values in Vercel.
# Generate a private value with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# Browser-accessible Flask URL. Next.js embeds this value during the build.
NEXT_PUBLIC_LOCAL_URL=http://127.0.0.1:8080

# Point both services to the same MongoDB instance and database.
MONGODB_URI=mongodb://127.0.0.1:27017/db
