# Backend (Flask) environment variables.
# Copy to .env for local dev; set these in the Render dashboard for production.

# MongoDB Atlas connection string (include the password). For hosting, allow 0.0.0.0/0
# under Atlas > Network Access so Render can connect.
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority

# Flask session signing key. Generate a new one with: openssl rand -hex 16
SECRET_KEY=replace-me
