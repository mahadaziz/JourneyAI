# Copy to .env for local development. Both services use the database named db.
MONGO_URI=mongodb://127.0.0.1:27017/db

# Generate a private value with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# For the hosted Groq model, set this key on the backend.
GROQ_API_KEY=

# Alternatively, use Hugging Face Inference Providers with inference credits.
HF_TOKEN=

# Optional chat model override for Hugging Face Inference Providers.
HF_MODEL=

# Optional dedicated text-generation endpoint that returns generated_text.
HF_INFERENCE_URL=
